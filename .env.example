# Copy to .env and fill in. scripts/generate.sh loads .env automatically.

# Required by the dialogue, validate and gate2 stages, unless `ant auth login` was run instead.
ANTHROPIC_API_KEY=

# Optional: YAML config overriding default settings (unset uses the built-in defaults).
PM_TRAITBENCH_CONFIG=configs/demo.yaml

# Optional: directory for pipeline tables (default: data).
PM_TRAITBENCH_DATA_DIR=data
